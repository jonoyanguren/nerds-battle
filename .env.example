# Prisma Postgres. La app usa el TCP (PRISMA_DIRECT_TCP_URL), no el websocket.
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=..."
PRISMA_DIRECT_TCP_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Auth.js. AUTH_SECRET hace falta aunque se juegue sin entrar (page.tsx llama a auth()).
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_TRUST_HOST="true"
